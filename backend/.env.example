# Скопируйте в .env и раскомментируйте для PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=rbac
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Без DB_NAME Django автоматически использует SQLite (backend/db.sqlite3)

SECRET_KEY=dev-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
